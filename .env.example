FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_DAYS=7
DATABASE_URL=sqlite:///backend/instance/minha_jornada.db

# For real production, prefer a managed database such as PostgreSQL or Supabase.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# On Vercel, DATABASE_URL must point to managed PostgreSQL; do not use SQLite.
